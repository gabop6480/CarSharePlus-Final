<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarSharePlusMobileExtended.MainPage"
             Title="Menú Principal"
             BackgroundColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Encabezado -->
            <Label Text="CarSharePlus"
                   Style="{StaticResource Headline}" />

            <!-- Tarjeta con sombra -->
            <Frame CornerRadius="12"
                   HasShadow="True"
                   BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource OffBlack}}"
                   Padding="20">

                <VerticalStackLayout Spacing="12">

                    <!-- Botones de navegación -->
                    <Button Text="Dashboard" Clicked="OnDashboardClicked" />
                    <Button Text="Mapas" Clicked="OnMapasClicked" />
                    <Button Text="Evaluaciones" Clicked="OnEvaluacionesClicked" />
                    <Button Text="Agregar Evaluación" Clicked="OnAgregarEvaluacionClicked" />
                    <Button Text="Editar Evaluación" Clicked="OnEditarEvaluacionClicked" />
                    <Button Text="Pagos" Clicked="OnPagosClicked" />
                    <Button Text="Perfil" Clicked="OnPerfilClicked" />
                    <Button Text="Reservar Vehículo" Clicked="OnReservarClicked" />
                    <Button Text="Reservas" Clicked="OnReservasClicked" />
                    <Button Text="Recomendaciones" Clicked="OnRecomendacionesClicked" />

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
