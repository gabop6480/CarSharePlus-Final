<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="CarSharePlusMobileExtended.Pages.DashboardPage"
             Title="Dashboard"
             BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Estadísticas de Reservas"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                   HorizontalOptions="Center" />

            <Frame CornerRadius="12"
                   HasShadow="True"
                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}"
                   Padding="20"
                   BorderColor="Gray">

                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding TotalReservas, StringFormat='Total Reservas: {0}'}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                    <BoxView HeightRequest="1" Color="Gray" Margin="0,5"/>

                    <Label Text="{Binding Activas, StringFormat='Activas: {0}'}"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                    <Label Text="{Binding Finalizadas, StringFormat='Finalizadas: {0}'}"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                    <Label Text="{Binding Canceladas, StringFormat='Canceladas: {0}'}"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                    <Label Text="{Binding PromedioDuracionHoras, StringFormat='Promedio duración: {0:F1} horas'}"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           FontSize="12"
                           Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <Frame CornerRadius="12"
                   HasShadow="True"
                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}"
                   Padding="20"
                   BorderColor="Gray">

                <VerticalStackLayout>
                    <Label Text="Distribución"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           Margin="0,0,0,10"/>

                    <microcharts:ChartView Chart="{Binding Chart}"
                                           HeightRequest="250"
                                           HorizontalOptions="FillAndExpand"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>  