<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="CarSharePlusMobileExtended.Pages.DashboardPage"
             Title="Dashboard"
             BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark={StaticResource OffBlack}}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="📊 Estadísticas de Reservas"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />

            <Frame CornerRadius="12"
                   HasShadow="True"
                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}"
                   BorderColor="#E5E7EB"
                   Padding="20">

                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding TotalReservas, StringFormat='Total Reservas: {0}'}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />

                    <BoxView HeightRequest="1" Color="#E5E7EB" Margin="0,5"/>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding Activas, StringFormat='🟢 Activas: {0}'}" TextColor="#1F2937"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Finalizadas, StringFormat='🔵 Finaliz.: {0}'}" TextColor="#1F2937"/>
                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding Canceladas, StringFormat='🔴 Cancel.: {0}'}" TextColor="#1F2937"/>
                    </Grid>

                    <Label Text="{Binding PromedioDuracionHoras, StringFormat='⏱️ Promedio: {0:F1} horas'}"
                           FontSize="14"
                           TextColor="Gray"
                           Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <Frame CornerRadius="12"
                   HasShadow="True"
                   BackgroundColor="White"
                   Padding="20"
                   HorizontalOptions="Fill">

                <VerticalStackLayout>
                    <Label Text="Distribución" FontAttributes="Bold" Margin="0,0,0,10" HorizontalOptions="Center"/>

                    <microcharts:ChartView Chart="{Binding Chart}"
                                           HeightRequest="250"
                                           HorizontalOptions="FillAndExpand"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>