<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CarSharePlusShared.ViewModels;assembly=CarSharePlusShared"
             xmlns:model="clr-namespace:CarSharePlusShared.Models;assembly=CarSharePlusShared"
             x:Class="CarSharePlusMobileExtended.Pages.PagosPage"
             x:DataType="vm:PagosViewModel"
             Title="Historial de Pagos" 
             BackgroundColor="#F3F4F6">

    <Grid RowDefinitions="Auto,*">
       
        <CollectionView Grid.Row="1" ItemsSource="{Binding ListaPagos}" Margin="10">
            <CollectionView.EmptyView>
                <Label Text="No hay pagos registrados." 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" 
                       TextColor="Gray"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:Pago">
                    <Frame Margin="0,5" Padding="15" BackgroundColor="White" CornerRadius="10" HasShadow="True" BorderColor="#E5E7EB">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding Metodo}" FontAttributes="Bold" TextColor="#1F2937" FontSize="16"/>
                                <Label Text="{Binding FechaPago, StringFormat='{0:dd/MM/yyyy}'}" FontSize="12" TextColor="Gray"/>
                                <Label Text="{Binding Confirmado, StringFormat='Estado: {0}'}" FontSize="10" TextColor="Gray"/>
                            </VerticalStackLayout>

                            <Label Grid.Column="1" 
                                   Text="{Binding Monto, StringFormat='${0:F2}'}" 
                                   TextColor="#10B981" 
                                   FontAttributes="Bold" 
                                   FontSize="18"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>