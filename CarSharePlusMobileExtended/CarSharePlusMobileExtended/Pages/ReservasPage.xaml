<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:CarSharePlusMobileExtended.Converters"
             x:Class="CarSharePlusMobileExtended.Pages.ReservasPage"
             x:Name="ReservasPageRoot"
             Title="Mis Reservas">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:EstadoReservaConverter x:Key="EstadoReservaConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Mis Reservas"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="#007AFF" />

        <CollectionView ItemsSource="{Binding Reservas}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#CCCCCC"
                            StrokeShape="RoundRectangle 12"
                            Padding="15"
                            Margin="8"
                            Background="{StaticResource SecondaryColor}">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnDefinitions="40,*"
                              ColumnSpacing="10"
                              RowSpacing="6">

                            <!-- Vehículo -->
                            <Image Grid.Row="0" Grid.Column="0"
                                   Source="car_icon.png"
                                   WidthRequest="24" HeightRequest="24"
                                   VerticalOptions="Center" />

                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Vehiculo.Marca}"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="#333" />

                            <!-- Fechas -->
                            <Image Grid.Row="1" Grid.Column="0"
                                   Source="calendar_icon.png"
                                   WidthRequest="24" HeightRequest="24"
                                   VerticalOptions="Center" />

                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding FechaInicio, StringFormat='{0:dd MMM}'}"
                                   FontSize="14"
                                   TextColor="#555" />

                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding FechaFin, StringFormat=' - {0:dd MMM}'}"
                                   FontSize="14"
                                   TextColor="#555"
                                   Margin="80,0,0,0" />

                            <!-- Estado -->
                            <Image Grid.Row="2" Grid.Column="0"
                                   Source="status_icon.png"
                                   WidthRequest="24" HeightRequest="24"
                                   VerticalOptions="Center" />

                            <Label Grid.Row="2" Grid.Column="1"
                                   Text="{Binding Estado}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{Binding Estado, Converter={StaticResource EstadoReservaConverter}}" />

                            <!-- Botones -->
                            <Grid Grid.Row="3" Grid.Column="1"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="10">
                                <Button Text="Editar"
                                        Command="{Binding BindingContext.EditarReservaCommand, Source={x:Reference ReservasPageRoot}}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#34C759"
                                        TextColor="White"
                                        CornerRadius="8" />

                                <Button Text="Cancelar"
                                        Command="{Binding BindingContext.CancelarReservaCommand, Source={x:Reference ReservasPageRoot}}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#FF3B30"
                                        TextColor="White"
                                        CornerRadius="8" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>