<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CarSharePlusShared.ViewModels;assembly=CarSharePlusShared"
             xmlns:model="clr-namespace:CarSharePlusShared.Models;assembly=CarSharePlusShared"
             x:Class="CarSharePlusMobileExtended.Pages.ReservarVehiculoPage"
             x:DataType="vm:VehiculosViewModel"
             Title="Catálogo de Vehículos"
             BackgroundColor="#F3F4F6">

    <Grid RowDefinitions="Auto, *">

        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding ListaVehiculos}" 
                        Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:Vehiculo">
                    <Frame Margin="0,5" Padding="15" CornerRadius="10" HasShadow="True" BackgroundColor="White" BorderColor="#E5E7EB">
                        <VerticalStackLayout Spacing="5">

                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{Binding Marca}" 
                                       FontAttributes="Bold" 
                                       FontSize="18" 
                                       TextColor="#1F2937"/>
                                <Label Text="{Binding Modelo}" 
                                       FontAttributes="Bold" 
                                       FontSize="18" 
                                       TextColor="#1F2937"/>
                            </HorizontalStackLayout>

                            <Label Text="{Binding TarifaPorHora, StringFormat='${0:F2}/h'}" 
                                   TextColor="#512BD4" 
                                   FontAttributes="Bold" 
                                   FontSize="18"/>

                            <BoxView HeightRequest="1" Color="#E5E7EB" Margin="0,5"/>

                            <HorizontalStackLayout Spacing="5">
                                <Label Text="Placa:" TextColor="#4B5563" FontAttributes="Bold" FontSize="14"/>
                                <Label Text="{Binding Placa}" TextColor="#4B5563" FontSize="14"/>
                                <Label Text="|" TextColor="#E5E7EB" Margin="5,0"/>
                                <Label Text="Año:" TextColor="#4B5563" FontAttributes="Bold" FontSize="14"/>
                                <Label Text="{Binding Anio}" TextColor="#4B5563" FontSize="14"/>
                            </HorizontalStackLayout>

                            <Label Text="Disponible" 
                                   TextColor="Gray" 
                                   FontSize="12" 
                                   FontAttributes="Italic"
                                   Margin="0,5,0,0"/>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>