<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CarSharePlusShared.ViewModels;assembly=CarSharePlusShared"
             x:Class="CarSharePlusMobileExtended.Pages.PerfilPage"
             x:DataType="vm:PerfilViewModel"
             Title="Mi Perfil" BackgroundColor="#F3F4F6">
    <VerticalStackLayout Spacing="20" Padding="30">
        <Frame CornerRadius="50" HeightRequest="100" WidthRequest="100" HorizontalOptions="Center" BackgroundColor="#512BD4" Padding="0">
            <Label Text="{Binding Usuario.Nombre, StringFormat='{0:F1}'}" TextColor="White" FontSize="40" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Frame>

        <Label Text="{Binding Usuario.Nombre}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#1F2937"/>

        <Frame BackgroundColor="White" CornerRadius="10" Padding="15">
            <VerticalStackLayout Spacing="10">
                <Label Text="Correo:" FontAttributes="Bold" TextColor="#512BD4"/>
                <Label Text="{Binding Usuario.Correo}" TextColor="Black"/>

                <BoxView HeightRequest="1" Color="LightGray"/>

                <Label Text="Teléfono:" FontAttributes="Bold" TextColor="#512BD4"/>
                <Label Text="{Binding Usuario.Telefono}" TextColor="Black"/>

                <BoxView HeightRequest="1" Color="LightGray"/>

                <Label Text="Rol:" FontAttributes="Bold" TextColor="#512BD4"/>
                <Label Text="{Binding Usuario.Rol}" TextColor="Black"/>
            </VerticalStackLayout>
        </Frame>
    </VerticalStackLayout>
</ContentPage>