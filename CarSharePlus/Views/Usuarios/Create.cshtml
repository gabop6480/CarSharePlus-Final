@model CarSharePlusShared.Models.Usuario

@{
    ViewData["Title"] = "Crear Usuario";
}

<h2 class="text-center fw-bold" style="color: goldenrod;">
    <i class="fas fa-user-plus"></i> Crear Usuario
</h2>

<!-- Mensajes de éxito y error -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success text-center mt-3">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger text-center mt-3">
        <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
    </div>
}

<!-- Mensaje informativo -->
<div class="alert alert-warning text-center mt-3">
    <i class="fas fa-info-circle"></i>
    <strong>Información:</strong> Complete los datos del nuevo usuario.
</div>

<form asp-action="Create" method="post" class="mt-4">
    <!-- Nombre -->
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label fw-bold"></label>
        <input asp-for="Nombre" class="form-control" placeholder="Ej. Juan Pérez" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <!-- Correo -->
    <div class="mb-3">
        <label asp-for="Correo" class="form-label fw-bold"></label>
        <input asp-for="Correo" class="form-control" type="email" placeholder="Ej. usuario@correo.com" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>

    <!-- Teléfono -->
    <div class="mb-3">
        <label asp-for="Telefono" class="form-label fw-bold"></label>
        <input asp-for="Telefono" class="form-control" type="tel" placeholder="Ej. +593987654321" />
        <span asp-validation-for="Telefono" class="text-danger"></span>
    </div>

    <!-- Rol -->
    <div class="mb-3">
        <label asp-for="Rol" class="form-label fw-bold"></label>
        <select asp-for="Rol" class="form-select">
            <option value="User">User</option>
            <option value="Admin">Admin</option>
        </select>
        <span asp-validation-for="Rol" class="text-danger"></span>
    </div>

    <!-- Contraseña -->
    <div class="mb-3">
        <label asp-for="Password" class="form-label fw-bold"></label>
        <input asp-for="Password" type="password" class="form-control" placeholder="Ingrese una contraseña segura" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <!-- Botones -->
    <div class="text-center mt-4">
        <button type="submit" class="btn btn-warning fw-bold me-2">
            <i class="fas fa-save"></i> Guardar
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
