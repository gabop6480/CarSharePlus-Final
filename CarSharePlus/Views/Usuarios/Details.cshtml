@model CarSharePlusShared.Models.Usuario
@using CarSharePlusShared.Models

@{
    ViewData["Title"] = "Detalles del Usuario";
}

<h2>Detalles del Usuario</h2>

<div class="alert alert-info">
    <strong>Información:</strong> Estos son los datos completos del usuario seleccionado.
</div>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>Nombre:</strong> @Model.Nombre</p>
        <p><strong>Correo:</strong> @Model.Correo</p>
        <p><strong>Teléfono:</strong> @Model.Telefono</p>
    </div>
</div>

<h4>Vehículos asignados</h4>

@if (Model.Vehiculos != null && Model.Vehiculos.Any())
{
    <p>Total de vehículos: <span class="badge badge-primary">@Model.Vehiculos.Count()</span></p>

    <table class="table table-bordered table-striped">
        <thead class="thead-dark">
            <tr>
                <th>Placa</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Año</th>
                <th>Transmisión</th>
                <th>Tipo de Energía</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in Model.Vehiculos)
            {
                <tr>
                    <td>@v.Placa</td>
                    <td>@v.Marca</td>
                    <td>@v.Modelo</td>
                    <td>@v.Anio</td>
                    <td>
                        @if (v.Transmision == TipoTransmision.Manual)
                        {
                            <i class="fas fa-cogs text-secondary" title="Manual"></i>
                            <text>Manual</text>
                                        }
                        else
                        {
                            <i class="fas fa-cog text-info" title="Automático"></i>
                            <text>Automático</text>
                                }
                    </td>
                    <td>
                        @if (v.Energia == TipoEnergia.Gasolina)
                        {
                            <i class="fas fa-gas-pump text-danger" title="Gasolina"></i>
                            <text>Gasolina</text>
                                        }
                        else if (v.Energia == TipoEnergia.Electrico)
                        {
                            <i class="fas fa-bolt text-success" title="Eléctrico"></i>
                            <text>Eléctrico</text>
                                }
                        else
                        {
                            <i class="fas fa-leaf text-warning" title="Híbrido"></i>
                            <text>Híbrido</text>
                                }
                    </td>
                    <td>
                        @if (v.Disponible)
                        {
                            <span class="badge badge-success"><i class="fas fa-check-circle"></i> Disponible</span>
                        }
                        else
                        {
                            <span class="badge badge-danger"><i class="fas fa-times-circle"></i> No disponible</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">
        <strong>Nota:</strong> Este usuario no tiene vehículos asignados.
    </div>
}

<div class="mt-3">
    <a class="btn btn-warning" href="@Url.Action("Edit", new { id = Model.Id })">
        <i class="fas fa-edit"></i> Editar
    </a>
    <a class="btn btn-secondary" href="@Url.Action("Index")">
        <i class="fas fa-arrow-left"></i> Volver
    </a>
</div>
