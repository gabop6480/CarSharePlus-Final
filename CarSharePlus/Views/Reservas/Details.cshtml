@model CarSharePlusShared.ViewModels.ReservaViewModel

@{
    ViewData["Title"] = "Detalles de la Reserva";

    var horas = (Model.FechaFin - Model.FechaInicio).TotalHours;

    var montoBase = (decimal)horas * Model.TarifaPorHora;

    var montoFinal = Model.MontoMostrar;
}

<h2>@ViewData["Title"]</h2>
<hr />

<div class="card mb-4">
    <div class="card-header bg-dark text-white">
        Información de la Reserva
    </div>

    <div class="card-body">
        <dl class="row">

            <dt class="col-sm-3">Usuario</dt>
            <dd class="col-sm-9">
                @Model.UsuarioNombre
            </dd>

            <dt class="col-sm-3">Vehículo</dt>
            <dd class="col-sm-9">
                @Model.VehiculoPlaca
            </dd>

            <dt class="col-sm-3">Fechas</dt>
            <dd class="col-sm-9">
                @Model.FechaInicio.ToString("dd/MM/yyyy HH:mm")
                -
                @Model.FechaFin.ToString("dd/MM/yyyy HH:mm")
            </dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                @Model.Estado
            </dd>

            <dt class="col-sm-3">Monto Base</dt>
            <dd class="col-sm-9">
                @montoBase.ToString("C")
                (por @horas.ToString("0.##") horas)
            </dd>

            <dt class="col-sm-3">Monto Final</dt>
            <dd class="col-sm-9 fw-bold text-success">
                @montoFinal.ToString("C")
            </dd>

        </dl>
    </div>
</div>

<hr />

<a asp-action="Edit"
   asp-route-id="@Model.Id"
   class="btn btn-warning">
    Editar
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Volver al listado
</a>
