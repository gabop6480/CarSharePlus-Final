@model IEnumerable<CarSharePlusShared.ViewModels.ReservaViewModel>
@using CarSharePlusShared.Models

@{
    ViewData["Title"] = "Mis Reservas";
}

<h2 class="text-center fw-bold mb-4" style="color: goldenrod;">
    <i class="fas fa-calendar-check"></i> Mis Reservas
</h2>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover shadow-sm">

            <thead class="table-warning text-center align-middle">
                <tr>
                    <th>Vehículo (Placa)</th>
                    <th>Fecha Inicio</th>
                    <th>Fecha Fin</th>
                    <th>Ubicación Inicio</th>
                    <th>Ubicación Fin</th>
                    <th>Estado</th>
                    <th>Monto Pago</th>
                    <th>Acciones</th>
                    <th>Calificación</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>
                            <i class="fas fa-car"></i>
                            @r.VehiculoPlaca
                        </td>

                        <td>@r.FechaInicio.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@r.FechaFin.ToString("dd/MM/yyyy HH:mm")</td>

                        <td>@r.UbicacionInicio</td>
                        <td>@r.UbicacionFin</td>

                        <td class="text-center">
                            @switch (r.Estado)
                            {
                                case EstadoReserva.Pendiente:
                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                    break;

                                case EstadoReserva.Activa:
                                    <span class="badge bg-success">Activa</span>
                                    break;

                                case EstadoReserva.Finalizada:
                                    <span class="badge bg-secondary">Finalizada</span>
                                    break;

                                case EstadoReserva.Cancelada:
                                    <span class="badge bg-danger">Cancelada</span>
                                    break;
                            }
                        </td>

                        <td>
                            💲 @(r.MontoPago.ToString("F2") ?? "0.00")
                        </td>

                        <td class="text-center">

                            <!-- 👁 VER -->
                            <a asp-action="Details" asp-route-id="@r.Id"
                               class="btn btn-sm btn-outline-warning me-1">
                                <i class="fas fa-eye"></i>
                            </a>

                            <!-- ✏ EDITAR -->
                            <a asp-action="Edit" asp-route-id="@r.Id"
                               class="btn btn-sm btn-outline-primary me-1">
                                <i class="fas fa-edit"></i>
                            </a>

                            <!-- 🗑 ELIMINAR -->
                            <a asp-action="Delete" asp-route-id="@r.Id"
                               class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-trash"></i>
                            </a>

                            <!-- ❌ CANCELAR -->
                            @if (r.Estado == EstadoReserva.Pendiente || r.Estado == EstadoReserva.Activa)
                            {
                                <form asp-action="Cancelar" method="post" style="display:inline">
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-ban"></i> Cancelar
                                    </button>
                                </form>
                            }

                            <!-- 💳 PAGAR -->
                            @if (r.Estado == EstadoReserva.Pendiente)
                            {
                                <a asp-controller="Pagos"
                                   asp-action="Create"
                                   asp-route-reservaId="@r.Id"
                                   class="btn btn-sm btn-outline-success ms-1">
                                    <i class="fas fa-credit-card"></i> Pagar
                                </a>
                            }
                            else if (r.Estado == EstadoReserva.Activa)
                            {
                                <span class="badge bg-info">Pagado</span>
                            }

                        </td>

                        <!-- ⭐ CALIFICACIÓN -->
                        <td class="text-center">

                            @if (r.Estado == EstadoReserva.Finalizada && r.Calificacion == 0)
                            {
                                <a asp-action="Calificar" asp-route-id="@r.Id"
                                   class="btn btn-sm btn-outline-info">
                                    <i class="fas fa-star"></i> Calificar
                                </a>
                            }
                            else if (r.Calificacion > 0)
                            {
                                <span class="text-warning">
                                    @for (int i = 0; i < r.Calificacion; i++)
                                    {
                                        <i class="fas fa-star"></i>
                                    }
                                </span>

                                @if (!string.IsNullOrEmpty(r.Comentario))
                                {
                                    <br />
                                    <small class="text-muted">"@r.Comentario"</small>
                                }
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }

                        </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info text-center mt-4">
        <i class="fas fa-info-circle"></i>
        📅 No tienes reservas registradas.
    </div>
}
