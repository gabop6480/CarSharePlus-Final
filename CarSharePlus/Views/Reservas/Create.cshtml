@model CarSharePlusShared.ViewModels.ReservaViewModel
@{
    ViewData["Title"] = "Crear Reserva";
}

<h2 class="text-center text-warning fw-bold">
    <i class="fas fa-calendar-plus"></i> Nueva Reserva
</h2>

<form asp-action="Create" method="post" id="formReserva">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger"></div>

    <!-- 🚗 SELECCIÓN DE VEHÍCULO -->
    <div class="form-group">
        <label class="fw-bold">Vehículo a reservar</label>
        <select asp-for="VehiculoId"
                asp-items=  "ViewBag.Vehiculos"
                class="form-control"
                id="vehiculoDropdown">
            <option value="">Seleccione un vehículo</option>
        </select>

        <span asp-validation-for="VehiculoId" class="text-danger"></span>
    </div>

    <!-- 🔍 INFO DEL VEHÍCULO -->
    <div id="vehiculoDetalles"
         class="alert alert-warning mt-3"
         style="display:none;">
    </div>

    <!-- 🕒 FECHAS -->
    <div class="row mt-3">
        <div class="col-md-6">
            <label asp-for="FechaInicio"></label>
            <input asp-for="FechaInicio"
                   class="form-control" 
                   type="datetime-local"
                   id="fechaInicio"
                   min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
            <span asp-validation-for="FechaInicio" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="FechaFin"></label>
            <input asp-for="FechaFin"
                   class="form-control"
                   type="datetime-local"
                   id="fechaFin" />
            <span asp-validation-for="FechaFin" class="text-danger"></span>
        </div>
    </div>

    <!-- 📍 UBICACIONES -->
    <div class="form-group mt-3">
        <label asp-for="UbicacionInicio"></label>
        <input asp-for="UbicacionInicio" class="form-control" />
        <span asp-validation-for="UbicacionInicio" class="text-danger"></span>
    </div>

    <div class="form-group mt-2">
        <label asp-for="UbicacionFin"></label>
        <input asp-for="UbicacionFin" class="form-control" />
        <span asp-validation-for="UbicacionFin" class="text-danger"></span>
    </div>

    <!-- 💵 MONTO AUTOMÁTICO -->
    <div class="form-group mt-3">
        <label>Total a pagar</label>
        <input class="form-control fw-bold" id="montoPago" readonly />

        <!-- ESTE ES EL QUE SE ENVÍA AL CONTROLLER -->
        <input type="hidden" asp-for="MontoPago" id="montoPagoHidden" value="0" />
    </div>

    <!-- BOTONES -->
    <div class="mt-4 text-center">
        <button type="submit" class="btn btn-warning fw-bold">
            <i class="fas fa-save"></i> Confirmar Reserva
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        let tarifaHora = 0;

        $('#vehiculoDropdown').change(function () {
            const id = $(this).val();
            if (!id) {
                $('#vehiculoDetalles').hide();
                tarifaHora = 0;
                calcular();
                return;
            }

            $.getJSON('/Reservas/InfoVehiculo?id=' + id, function (v) {
                tarifaHora = v.tarifaPorHora;

                $('#vehiculoDetalles').html(`
                    <strong>${v.marca} ${v.modelo}</strong><br/>
                    Placa: ${v.placa}<br/>
                    Tarifa: $${v.tarifaPorHora}/hora<br/>
                    Autonomía: ${v.autonomiaKm} km
                `).show();

                calcular();
            });
        });

        $('#fechaInicio, #fechaFin').change(calcular);

        function calcular() {
            const inicioVal = $('#fechaInicio').val();
            const finVal = $('#fechaFin').val();

            if (!inicioVal || !finVal || tarifaHora <= 0) {
                limpiar();
                $('#montoPagoHidden').val(0);
                return;
            }

            const inicio = new Date(inicioVal);
            const fin = new Date(finVal);

            if (fin <= inicio) {
                limpiar();
                $('#montoPagoHidden').val(0);
                return;
            }

            const horas = (fin - inicio) / 3600000;
            const total = (horas * tarifaHora).toFixed(2);

            $('#montoPago').val('$' + total);
            $('#montoPagoHidden').val(parseFloat(total));
        }

        function limpiar() {
            $('#montoPago').val('');
            $('#montoPagoHidden').val(0);
        }

        // 🔹 Garantizar valor válido antes de enviar
        $('#formReserva').submit(function() {
            if (!$('#montoPagoHidden').val()) {
                $('#montoPagoHidden').val(0);
            }
        });
    </script>
}
