@{
    ViewData["Title"] = "Inicio";
}

<!-- Hero con imagen de fondo -->
<div class="hero-section text-center d-flex align-items-center justify-content-center"
     style="background-image: url('/images/porsche.jpg'); background-size: cover; background-position: center; height: 500px;">
    <div style="background-color: rgba(255,255,255,0.7); padding: 30px; border-radius: 10px;">
        <h1 class="display-4" style="color: goldenrod;">CarSharePlus</h1>
        <p class="lead">Lujo, velocidad y eficiencia al alcance de tu reserva</p>
        <div class="mt-3">
            @* Botón de reserva removido temporalmente para evitar errores *@
        </div>
    </div>
</div>

<!-- Sección de ventajas -->
<div class="container mt-5">
    <div class="row text-center">
        <div class="col-md-4">
            <i class="fas fa-car-side fa-3x" style="color: goldenrod;"></i>
            <h5 class="mt-3">Vehículos Premium</h5>
            <p>Explora nuestra flota de autos de lujo y alto rendimiento.</p>
        </div>
        <div class="col-md-4">
            <i class="fas fa-calendar-check fa-3x" style="color: goldenrod;"></i>
            <h5 class="mt-3">Reservas fáciles</h5>
            <p>Gestiona tus reservas en segundos desde cualquier dispositivo.</p>
        </div>
        <div class="col-md-4">
            <i class="fas fa-credit-card fa-3x" style="color: goldenrod;"></i>
            <h5 class="mt-3">Pagos seguros</h5>
            <p>Transacciones rápidas y confiables con total seguridad.</p>
        </div>
    </div>
</div>
