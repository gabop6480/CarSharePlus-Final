@model IEnumerable<CarSharePlusShared.Models.Pago>

@{
    ViewData["Title"] = "Mis Pagos";
}

<h2 class="text-center fw-bold" style="color: goldenrod;">
    <i class="fas fa-credit-card"></i> Mis Pagos
</h2>

@if (Model != null && Model.Any())
{
    <table class="table table-bordered table-hover mt-4">
        <thead class="table-warning">
            <tr>
                <th>Reserva</th>
                <th>Vehículo</th>
                <th>Placa</th>
                <th>Pagador</th>
                <th>Monto</th>
                <th>Fecha de Pago</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                // Solo mostrar si soy pagador o dueño del vehículo
                if (p.Reserva.UsuarioId != ViewBag.UsuarioActual && p.Reserva.Vehiculo.UsuarioId != ViewBag.UsuarioActual)
                {
                    continue; // salta este pago
                }

                <tr>
                    <td>#@p.ReservaId</td>
                    <td>@p.Reserva?.Vehiculo?.Marca @p.Reserva?.Vehiculo?.Modelo</td>
                    <td>@p.Reserva?.Vehiculo?.Placa</td>
                    <td>@p.Reserva?.Usuario?.Nombre</td>
                    <td>@p.Monto.ToString("C")</td>
                    <td>@p.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (p.Confirmado)
                        {
                            <span class="badge bg-success">Pagado</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">Pendiente</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-warning">
                            <i class="fas fa-eye"></i> Ver
                        </a>
                    </td>
                </tr>
            }

        </tbody>
    </table>
}
else
{
    <div class="alert alert-info text-center mt-4">
        <i class="fas fa-info-circle"></i> 💳 No tienes pagos registrados.
    </div>
}
