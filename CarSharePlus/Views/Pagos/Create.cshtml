@model CarSharePlusShared.Models.Pago

@{
    ViewData["Title"] = "Registrar Pago";
}

<h2>@ViewData["Title"]</h2>
<hr />

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="ReservaId" />

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Detalle de la Reserva</h5>
            <p><strong>Usuario:</strong> @Model.Reserva?.Usuario?.Nombre</p>
            <p><strong>Vehículo:</strong> @Model.Reserva?.Vehiculo?.Marca @Model.Reserva?.Vehiculo?.Modelo</p>
            <p><strong>Placa:</strong> @Model.Reserva?.Vehiculo?.Placa</p>
            <p><strong>Dueño:</strong> @Model.Reserva?.Vehiculo?.Usuario?.Nombre</p>
            <p><strong>Desde:</strong> @Model.Reserva?.FechaInicio.ToString("g")</p>
            <p><strong>Hasta:</strong> @Model.Reserva?.FechaFin.ToString("g")</p>
            <p><strong>Monto:</strong> @Model.Monto.ToString("C")</p>
        </div>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Metodo" class="form-label"></label>
        <select asp-for="Metodo" class="form-select">
            <option value="">-- Seleccione --</option>
            <option value="Tarjeta">Tarjeta</option>
            <option value="Efectivo">Efectivo</option>
            <option value="Transferencia">Transferencia</option>
        </select>
        <span asp-validation-for="Metodo" class="text-danger"></span>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Pagar</button>
        <a asp-action="MisReservas" asp-controller="Reservas" class="btn btn-secondary">Volver</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
