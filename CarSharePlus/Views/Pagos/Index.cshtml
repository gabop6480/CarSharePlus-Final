@model IEnumerable<CarSharePlusShared.Models.Pago>

@{
    ViewData["Title"] = "Pagos";
}

<h2>@ViewData["Title"]</h2>
<hr />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Reserva</th>
            <th>Monto</th>
            <th>Fecha</th>
            <th>Método</th>
            <th>Confirmado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted">No hay pagos registrados.</td>
            </tr>
        }
        else
        {
            foreach (var pago in Model)
            {
                <tr>
                    <td>
                        @if (pago.Reserva != null)
                        {
                            <text>
                                <strong>@pago.Reserva.Usuario?.Nombre</strong><br />
                                @pago.Reserva.Vehiculo?.Marca @pago.Reserva.Vehiculo?.Modelo (@pago.Reserva.Vehiculo?.Placa)<br />
                                <small>
                                    @($"{pago.Reserva.FechaInicio:dd/MM/yyyy HH:mm} - {pago.Reserva.FechaFin:dd/MM/yyyy HH:mm}")
                                </small>
                            </text>
                        }
                        else
                        {
                            <span class="text-muted">Reserva #@pago.ReservaId</span>
                        }
                    </td>


                    <td>@pago.Monto.ToString("C")</td>
                    <td>@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@pago.Metodo</td>
                    <td>
                        @if (pago.Confirmado)
                        {
                            <span class="badge bg-success"><i class="bi bi-check-circle"></i> Sí</span>
                        }
                        else
                        {
                            <span class="badge bg-danger"><i class="bi bi-x-circle"></i> No</span>
                        }
                    </td>
                    <td>
                        @if (!pago.Confirmado)
                        {
                            <a asp-action="Confirmar" asp-route-id="@pago.Id" class="btn btn-sm btn-success">Confirmar</a>
                        }
                        <a asp-action="Details" asp-route-id="@pago.Id" class="btn btn-sm btn-dark">Detalles</a>
                        <a asp-action="Edit" asp-route-id="@pago.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Delete" asp-route-id="@pago.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        <a asp-controller="Reservas" asp-action="Details" asp-route-id="@pago.ReservaId" class="btn btn-sm btn-info">Ver Reserva</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary">Registrar nuevo pago</a>
