@model CarSharePlusShared.ViewModels.VehiculoViewModel
@using CarSharePlusShared.Models

@{
    ViewData["Title"] = "Crear Vehículo";
}

<h2>Crear Vehículo</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="alert alert-info">
    <i class="fas fa-info-circle"></i>
    <strong>Información:</strong> Complete los datos del vehículo.
</div>

<div class="card mb-3">
    <div class="card-body">

        <form asp-action="Create">

            <!-- 🔥 MUESTRA TODOS LOS ERRORES REALES -->
            <div asp-validation-summary="All" class="text-danger"></div>

            <!-- ===== DATOS BÁSICOS ===== -->

            <div class="form-group">
                <label asp-for="Marca"></label>
                <input asp-for="Marca" class="form-control" placeholder="Ej. Toyota" />
                <span asp-validation-for="Marca" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Modelo"></label>
                <input asp-for="Modelo" class="form-control" placeholder="Ej. Corolla" />
                <span asp-validation-for="Modelo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Anio"></label>
                <input asp-for="Anio" type="number" class="form-control"
                       min="1990" max="2050" placeholder="Ej. 2024" />
                <span asp-validation-for="Anio" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Placa"></label>
                <input asp-for="Placa" class="form-control" placeholder="Ej. ABC-1234" />
                <span asp-validation-for="Placa" class="text-danger"></span>
            </div>

            <!-- ===== CARACTERÍSTICAS ===== -->

            <div class="form-group">
                <label asp-for="Transmision"></label>
                <select asp-for="Transmision"
                        class="form-control"
                        asp-items="Html.GetEnumSelectList<TipoTransmision>()">
                </select>
                <span asp-validation-for="Transmision" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Energia"></label>
                <select asp-for="Energia"
                        class="form-control"
                        asp-items="Html.GetEnumSelectList<TipoEnergia>()">
                </select>
                <span asp-validation-for="Energia" class="text-danger"></span>
            </div>

            <div class="form-group form-check">
                <input asp-for="Disponible" class="form-check-input" />
                <label asp-for="Disponible" class="form-check-label"></label>
            </div>

            <div class="form-group">
                <label asp-for="AutonomiaKm"></label>
                <input asp-for="AutonomiaKm" class="form-control" placeholder="Ej. 400" />
                <span asp-validation-for="AutonomiaKm" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConsumoPorKm"></label>
                <input asp-for="ConsumoPorKm" class="form-control" placeholder="Ej. 0.12" />
                <span asp-validation-for="ConsumoPorKm" class="text-danger"></span>
            </div>

            <!-- 🚨 ESTO FALTABA Y MATABA TODO -->
            <div class="form-group">
                <label asp-for="TarifaPorHora"></label>
                <input asp-for="TarifaPorHora"
                       class="form-control"
                       placeholder="Ej. 5.50" />
                <span asp-validation-for="TarifaPorHora" class="text-danger"></span>
            </div>

            <!-- 🌎 UBICACIÓN OPCIONAL POR AHORA -->
            <input type="hidden" asp-for="Latitud" value="0" />
            <input type="hidden" asp-for="Longitud" value="0" />

            <hr />

            <!-- BOTONES -->
            <button type="submit" class="btn btn-success">
                <i class="fas fa-save"></i> Guardar
            </button>

            <a class="btn btn-secondary" href="@Url.Action("MisVehiculos")">
                <i class="fas fa-arrow-left"></i> Volver
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
