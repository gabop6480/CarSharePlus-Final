@{
    ViewData["Title"] = "Dashboard de Evaluaciones";
}

<h2 class="mb-4 text-center"><i class="bi bi-bar-chart-fill"></i> Dashboard de Evaluaciones</h2>

<!-- =======================
     KPIs Rápidos
======================= -->
<div class="row mb-4 g-3">
    <div class="col-md-3">
        <div class="card shadow-sm text-center h-100">
            <div class="card-body">
                <h6 class="card-title text-muted">Total Evaluaciones</h6>
                <h3 class="fw-bold text-primary">
                    @(((IEnumerable<dynamic>)ViewBag.Distribucion).Sum(d => (int)d.Total))
                </h3>
                <i class="bi bi-clipboard-data fs-2 text-primary"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm text-center h-100">
            <div class="card-body">
                <h6 class="card-title text-muted">Promedio Global</h6>
                <h3 class="fw-bold text-success">
                    @((double)ViewBag.PromedioGlobal).ToString("0.0")
                </h3>
                <i class="bi bi-star-fill fs-2 text-warning"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm text-center h-100">
            <div class="card-body">
                <h6 class="card-title text-muted">Total Vehículos Evaluados</h6>
                <h3 class="fw-bold text-info">
                    @(((IEnumerable<dynamic>)ViewBag.PromedioPorVehiculo).Count())
                </h3>
                <i class="bi bi-car-front-fill fs-2 text-info"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm text-center h-100">
            <div class="card-body">
                <h6 class="card-title text-muted">Top Usuarios</h6>
                <h3 class="fw-bold text-warning">
                    @(((IEnumerable<dynamic>)ViewBag.TopUsuarios).Count())
                </h3>
                <i class="bi bi-people-fill fs-2 text-warning"></i>
            </div>
        </div>
    </div>
</div>

<!-- =======================
     Gráficos
======================= -->
<div class="row g-4">
    <!-- Distribución de Calificaciones -->
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">⭐ Distribución de Calificaciones</div>
            <div class="card-body">
                <canvas id="chartCalificaciones" height="200"></canvas>
            </div>
        </div>
    </div>

    <!-- Distribución de Calificaciones de Reservas -->
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">📦 Calificaciones de Reservas Finalizadas</div>
            <div class="card-body">
                <canvas id="chartReservas" height="200"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- =======================
     Tablas
======================= -->
<div class="row g-4 mt-3">
    <!-- Promedio por Vehículo -->
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">📊 Promedio de Calificaciones por Vehículo</div>
            <div class="card-body table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Vehículo</th>
                            <th>Promedio</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in (IEnumerable<dynamic>)ViewBag.PromedioPorVehiculo)
                        {
                            <tr>
                                <td>@item.Vehiculo</td>
                                <td>@((double)item.Promedio).ToString("0.0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Top Usuarios -->
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">👥 Top 3 Usuarios más Activos</div>
            <div class="card-body table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Usuario</th>
                            <th>Total Evaluaciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in (IEnumerable<dynamic>)ViewBag.TopUsuarios)
                        {
                            <tr>
                                <td>@item.Usuario</td>
                                <td>@item.Total</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Ranking de Vehículos -->
<div class="row g-4 mt-3">
    <div class="col-lg-12">
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white">🏆 Vehículos Recomendados (Top 5)</div>
            <div class="card-body table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Vehículo</th>
                            <th>Promedio de Calificación</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in (IEnumerable<dynamic>)ViewBag.RankingVehiculos)
                        {
                            <tr>
                                <td>@item.Vehiculo</td>
                                <td>@((double)item.Promedio).ToString("0.0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // 🔹 Distribución de Calificaciones
        new Chart(document.getElementById('chartCalificaciones').getContext('2d'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                    ((IEnumerable<dynamic>)ViewBag.Distribucion).Select(d => d.Calificacion))),
            datasets: [{
                label: 'Cantidad',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                        ((IEnumerable<dynamic>)ViewBag.Distribucion).Select(d => d.Total))),
                backgroundColor: 'rgba(54, 162, 235, 0.6)',
                borderColor: 'rgba(54, 162, 235, 1)',
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                title: { display: true, text: 'Distribución de Calificaciones' },
                legend: { display: false }
            },
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });

        // 🔹 Distribución de Calificaciones de Reservas
        new Chart(document.getElementById('chartReservas').getContext('2d'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ReservaLabels)),
                datasets: [{
                    label: 'Cantidad',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ReservaValues)),
                    backgroundColor: 'rgba(255, 159, 64, 0.6)',
                    borderColor: 'rgba(255, 159, 64, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    title: { display: true, text: 'Distribución de Calificaciones de Reservas' },
                    legend: { display: false }
                },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });
    </script>
}
